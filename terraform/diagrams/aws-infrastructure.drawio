        <mxCell id="dev" value="Dev OU / 환경 root&#xa;&#xa;VPC 10.10.0.0/16 · 2 AZ&#xa;Landing Zone TGW · S3 Gateway Endpoint&#xa;EKS 1.35 · Spot 1개 node group&#xa;Control/Container 로그 90/30일&#xa;Prometheus 7일 · Backup 14일&#xa;업무시간 Scheduler 사용" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E3FCEF;strokeColor=#00875A;fontColor=#172B4D;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="615" y="325" width="265" height="300" as="geometry"/></mxCell>
        <mxCell id="stg" value="Stg OU / 환경 root&#xa;&#xa;VPC 10.15.0.0/16 · 2 AZ&#xa;Landing Zone TGW · Interface Endpoint 5종&#xa;EKS 1.35 · On-Demand 1개 node group&#xa;Control/Container 로그 90/90일&#xa;Prometheus 15일 · Backup 35일&#xa;업무시간 Scheduler 사용" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DEEBFF;strokeColor=#0052CC;fontColor=#172B4D;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="905" y="325" width="265" height="300" as="geometry"/></mxCell>
        <mxCell id="prod" value="Prod OU / 환경 root&#xa;&#xa;VPC 10.20.0.0/16 · 3 AZ&#xa;Landing Zone TGW · Interface Endpoint 8종&#xa;EKS 1.35 · System/Application node group&#xa;Control/Container 로그 365/365일&#xa;Prometheus 30일 · Backup 35일&#xa;Vault Lock · Scheduler 미사용" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFEBE6;strokeColor=#DE350B;fontColor=#172B4D;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1195" y="325" width="265" height="300" as="geometry"/></mxCell>
        <mxCell id="account-note" value="중요 경계: terraform/organization은 조직과 OU를 생성하지만 aws_organizations_account는 만들지 않습니다. dev/stg/prod root는 지정된 workload 계정에 배포되는 독립 상태입니다." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF7D6;strokeColor=#FFAB00;fontColor=#172B4D;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="615" y="655" width="845" height="75" as="geometry"/></mxCell>

