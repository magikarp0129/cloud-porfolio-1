{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/incident-request.schema.json",
  "title": "Monitoring Agent incident request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "agent_id",
    "task",
    "repository",
    "environment",
    "mode",
    "incident_ticket",
    "data_classification",
    "max_cost_usd",
    "incident",
    "scope"
  ],
  "properties": {
    "request_id": {"type": "string", "pattern": "^req-[A-Za-z0-9][A-Za-z0-9-]{5,127}$"},
    "agent_id": {"const": "monitoring"},
    "task": {"type": "string", "minLength": 1, "maxLength": 2000},
    "repository": {"type": "string", "minLength": 1, "maxLength": 256},
    "environment": {"enum": ["dev", "stg", "prod"]},
    "mode": {"const": "read"},
    "incident_ticket": {"type": "string", "pattern": "^INC-[0-9]{4}-[0-9]{4,12}$"},
    "data_classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "max_cost_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 25},
    "timeout_seconds": {"type": "integer", "minimum": 10, "maximum": 900},
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "started_at", "ended_at"],
      "properties": {
        "severity": {"enum": ["critical", "high", "warning", "info"]},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"}
      }
    },
    "scope": {
      "type": "object",
      "required": ["region", "service"],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9/][A-Za-z0-9_.:/=@+\\-]{0,255}$"
      },
      "properties": {
        "region": {"type": "string"},
        "service": {"type": "string"},
        "cluster": {"type": "string"},
        "namespace": {"type": "string"}
      }
    },
    "requested_queries": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/=@+\\-]{0,255}$"}
    }
  }
}
