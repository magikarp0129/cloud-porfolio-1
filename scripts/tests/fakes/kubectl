#!/usr/bin/env bash

set -euo pipefail

case "$*" in
  "config get-contexts test-eks -o name")
    printf 'test-eks\n'
    ;;
  *"auth can-i get nodes"*)
    printf 'yes\n'
    ;;
  *"cluster-info"*)
    printf 'Kubernetes control plane is running at https://127.0.0.1\n'
    ;;
  *"get nodes"*)
    printf 'node-a Ready worker 1d v1.35.0 10.0.1.10 none AL2023 6.1 containerd\n'
    ;;
  *"get pods"*)
    printf 'payments api-pending Pending Unschedulable node-a\n'
    ;;
  *"get deployments,statefulsets,daemonsets"*)
    printf 'payments deployment.apps/api 3/3 3 3 1d\n'
    ;;
  *"get poddisruptionbudgets,horizontalpodautoscalers"*)
    printf 'payments poddisruptionbudget.policy/api 1 2 1d\n'
    ;;
  *"get persistentvolumeclaims"*)
    printf 'payments persistentvolumeclaim/data Bound pvc-123 10Gi gp3 1d Filesystem\n'
    ;;
  *"get events"*)
    printf 'payments 1m Warning FailedScheduling pod/api-pending insufficient cpu\n'
    ;;
  *)
    printf 'unsupported fake kubectl call: %s\n' "$*" >&2
    exit 64
    ;;
esac
