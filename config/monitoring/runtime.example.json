{
  "schema_version": "1.0",
  "policy_version": "monitoring-readonly-2026-08-08",
  "limits": {
    "max_window_minutes": 120,
    "max_tool_calls": 20,
    "max_log_groups": 5,
    "max_log_rows": 200,
    "max_response_bytes": 1000000,
    "tool_timeout_seconds": 30
  },
  "environments": {
    "dev": {
      "aws_account_id": "111111111111",
      "diagnostic_role_arn": "arn:aws:iam::111111111111:role/portfolio-dev-monitoring-diagnostic",
      "region": "ap-northeast-2",
      "services": {
        "example-api": {
          "cluster_arn": "arn:aws:eks:ap-northeast-2:111111111111:cluster/portfolio-dev-eks",
          "scope": {
            "cluster": "portfolio-dev-eks",
            "namespace": "application-dev",
            "alb_load_balancer": "app/portfolio-dev/0123456789abcdef",
            "workload_log_group": "/workload/dev/application-dev/example-api"
          }
        }
      },
      "allowed_data_classifications": ["internal"],
      "max_window_minutes": 120
    },
    "stg": {
      "aws_account_id": "222222222222",
      "diagnostic_role_arn": "arn:aws:iam::222222222222:role/portfolio-stg-monitoring-diagnostic",
      "region": "ap-northeast-2",
      "services": {
        "example-api": {
          "cluster_arn": "arn:aws:eks:ap-northeast-2:222222222222:cluster/portfolio-stg-eks",
          "scope": {
            "cluster": "portfolio-stg-eks",
            "namespace": "application-stg",
            "alb_load_balancer": "app/portfolio-stg/0123456789abcdef",
            "workload_log_group": "/workload/stg/application-stg/example-api"
          }
        }
      },
      "allowed_data_classifications": ["internal"],
      "max_window_minutes": 120
    },
    "prod": {
      "aws_account_id": "333333333333",
      "diagnostic_role_arn": "arn:aws:iam::333333333333:role/portfolio-prod-monitoring-diagnostic",
      "region": "ap-northeast-2",
      "services": {
        "example-api": {
          "cluster_arn": "arn:aws:eks:ap-northeast-2:333333333333:cluster/portfolio-prod-eks",
          "scope": {
            "cluster": "portfolio-prod-eks",
            "namespace": "application-prod",
            "alb_load_balancer": "app/portfolio-prod/0123456789abcdef",
            "workload_log_group": "/workload/prod/application-prod/example-api"
          }
        }
      },
      "allowed_data_classifications": ["internal"],
      "max_window_minutes": 120
    }
  },
  "sources": {
    "cloudwatch": {
      "enabled": true,
      "metric_queries": [
        {
          "id": "alb_target_5xx",
          "namespace": "AWS/ApplicationELB",
          "metric_name": "HTTPCode_Target_5XX_Count",
          "statistic": "Sum",
          "period_seconds": 60,
          "dimensions": {
            "LoadBalancer": "{alb_load_balancer}"
          }
        }
      ],
      "logs_insights_queries": [
        {
          "id": "workload_error_summary",
          "log_groups": ["{workload_log_group}"],
          "query": "fields @timestamp, error_code, deployment_version | filter level = 'error' | stats count(*) as errors by error_code, deployment_version | sort errors desc",
          "allowed_fields": ["error_code", "deployment_version", "errors"],
          "limit": 100
        }
      ]
    },
    "kubernetes": {
      "enabled": true,
      "context_by_environment": {
        "dev": "portfolio-dev-eks-readonly",
        "stg": "portfolio-stg-eks-readonly",
        "prod": "portfolio-prod-eks-readonly"
      },
      "workload_selector": "app.kubernetes.io/name={service}"
    },
    "prometheus": {
      "enabled": false,
      "base_url_env": "AGENT_PROMETHEUS_URL",
      "token_env": "AGENT_PROMETHEUS_TOKEN",
      "allowed_hosts": ["prometheus.example.internal"],
      "queries": [
        {
          "id": "host_cpu_utilization_percent",
          "query": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "step_seconds": 60,
          "max_series": 50
        },
        {
          "id": "host_memory_utilization_percent",
          "query": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "step_seconds": 60,
          "max_series": 50
        },
        {
          "id": "host_filesystem_utilization_percent",
          "query": "100 * (1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"}))",
          "step_seconds": 60,
          "max_series": 50
        },
        {
          "id": "host_inode_utilization_percent",
          "query": "100 * (1 - (node_filesystem_files_free{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_files{fstype!~\"tmpfs|overlay|squashfs\"}))",
          "step_seconds": 60,
          "max_series": 50
        },
        {
          "id": "workload_cpu_request_utilization_percent",
          "query": "100 * sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{namespace=\"{namespace}\",container!=\"\",image!=\"\"}[5m])) / clamp_min(sum by (namespace, pod) (kube_pod_container_resource_requests{namespace=\"{namespace}\",resource=\"cpu\",unit=\"core\"}), 0.001)",
          "step_seconds": 60,
          "max_series": 100
        },
        {
          "id": "workload_memory_limit_utilization_percent",
          "query": "100 * container_memory_working_set_bytes{namespace=\"{namespace}\",container!=\"\",image!=\"\"} / clamp_min(kube_pod_container_resource_limits{namespace=\"{namespace}\",resource=\"memory\",unit=\"byte\"}, 1)",
          "step_seconds": 60,
          "max_series": 100
        },
        {
          "id": "workload_cpu_throttling_percent",
          "query": "100 * sum by (namespace, pod, container) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"{namespace}\"}[5m])) / clamp_min(sum by (namespace, pod, container) (rate(container_cpu_cfs_periods_total{namespace=\"{namespace}\"}[5m])), 0.001)",
          "step_seconds": 60,
          "max_series": 100
        },
        {
          "id": "service_request_latency_p95_seconds",
          "query": "histogram_quantile(0.95, sum by (le, service) (rate(http_server_request_duration_seconds_bucket{service=\"{service}\"}[5m])))",
          "step_seconds": 60,
          "max_series": 20
        },
        {
          "id": "k8s_node_not_ready_count",
          "query": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"} == 0)",
          "step_seconds": 60,
          "max_series": 10
        },
        {
          "id": "monitoring_target_up",
          "query": "max by (job, instance) (up)",
          "step_seconds": 60,
          "max_series": 100
        },
        {
          "id": "pod_restart_delta",
          "query": "sum by (namespace, workload, reason) (increase(kube_pod_container_status_restarts_total{namespace=\"{namespace}\"}[5m]))",
          "step_seconds": 60,
          "max_series": 50
        }
      ]
    },
    "grafana": {
      "enabled": false,
      "base_url_env": "AGENT_GRAFANA_URL",
      "token_env": "AGENT_GRAFANA_VIEWER_TOKEN",
      "allowed_hosts": ["grafana.example.internal"],
      "dashboards": [
        {
          "id": "service_overview_dashboard",
          "uid": "service-overview"
        }
      ]
    }
  }
}
