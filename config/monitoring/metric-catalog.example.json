{
  "schema_version": "1.0",
  "status": "target-example-not-production-evidence",
  "description": "OpenTelemetry logical metric names and their expected Prometheus query names for the notification service example.",
  "defaults": {
    "owner": "replace-with-service-owner",
    "export_profile": "always-on-prometheus",
    "scrape_or_export_interval_seconds": 30,
    "retention_class": "environment-default",
    "pii_review_status": "required-before-production",
    "promql_translation_status": "must-pass-golden-test"
  },
  "cardinality_policy": {
    "max_custom_attributes_per_metric": 8,
    "max_active_series_per_service": 10000,
    "max_active_series_per_namespace": 50000,
    "warning_percent": 80,
    "production_action_at_limit": "block-new-metric-or-label-rollout"
  },
  "forbidden_attributes": [
    "user.id",
    "customer.id",
    "recipient.phone_number",
    "email",
    "request.id",
    "trace_id",
    "span_id",
    "message.id",
    "http.url",
    "url.query",
    "exception.message",
    "exception.stacktrace"
  ],
  "metrics": [
    {
      "otel_name": "http.server.request.duration",
      "expected_promql_name": "http_server_request_duration_seconds",
      "instrument": "Histogram",
      "unit": "s",
      "description": "Server request duration using the OpenTelemetry HTTP semantic convention.",
      "allowed_attributes": [
        "http.request.method",
        "http.route",
        "http.response.status_code"
      ],
      "attribute_value_limits": {
        "http.route": 100,
        "http.request.method": 10,
        "http.response.status_code": 20
      },
      "expected_max_active_series": 4000,
      "consumers": [
        "service-overview-dashboard",
        "latency-sli",
        "latency-alert"
      ],
      "autoscaling": {
        "allowed": false,
        "reason": "Latency is a lagging signal and is not used alone for scaling."
      }
    },
    {
      "otel_name": "http.server.active_requests",
      "expected_promql_name": "http_server_active_requests",
      "instrument": "UpDownCounter",
      "unit": "{request}",
      "description": "Requests currently being processed by an application instance.",
      "allowed_attributes": [
        "http.request.method",
        "http.route"
      ],
      "attribute_value_limits": {
        "http.route": 100,
        "http.request.method": 10
      },
      "expected_max_active_series": 2000,
      "consumers": [
        "service-overview-dashboard",
        "saturation-alert",
        "hpa-recording-rule"
      ],
      "autoscaling": {
        "allowed": true,
        "provider": "prometheus-adapter",
        "recording_rule": "hpa:service_active_requests:avg_per_pod_2m",
        "requires_stale_and_missing_metric_test": true
      }
    },
    {
      "otel_name": "portfolio.notification.accepted",
      "expected_promql_name": "portfolio_notification_accepted_total",
      "instrument": "Counter",
      "unit": "{notification}",
      "description": "Notifications accepted for asynchronous processing.",
      "allowed_attributes": [
        "channel",
        "result"
      ],
      "attribute_value_limits": {
        "channel": 10,
        "result": 5
      },
      "expected_max_active_series": 50,
      "consumers": [
        "notification-throughput-dashboard",
        "completion-sli-denominator"
      ],
      "autoscaling": {
        "allowed": false,
        "reason": "Use source-native queue backlog for worker scaling."
      }
    },
    {
      "otel_name": "portfolio.notification.completed",
      "expected_promql_name": "portfolio_notification_completed_total",
      "instrument": "Counter",
      "unit": "{notification}",
      "description": "Notifications completed with a bounded outcome class.",
      "allowed_attributes": [
        "channel",
        "result"
      ],
      "attribute_value_limits": {
        "channel": 10,
        "result": 10
      },
      "expected_max_active_series": 100,
      "consumers": [
        "notification-throughput-dashboard",
        "completion-sli-numerator",
        "completion-alert"
      ],
      "autoscaling": {
        "allowed": false,
        "reason": "Completion is an outcome signal, not an early capacity signal."
      }
    },
    {
      "otel_name": "portfolio.notification.retry",
      "expected_promql_name": "portfolio_notification_retry_total",
      "instrument": "Counter",
      "unit": "{notification}",
      "description": "Retry attempts classified by a bounded operational reason.",
      "allowed_attributes": [
        "provider",
        "reason_class"
      ],
      "attribute_value_limits": {
        "provider": 10,
        "reason_class": 20
      },
      "expected_max_active_series": 200,
      "consumers": [
        "provider-dashboard",
        "retry-storm-alert"
      ],
      "autoscaling": {
        "allowed": false,
        "reason": "Retries can amplify a dependency incident."
      }
    },
    {
      "otel_name": "portfolio.notification.dlq.enqueued",
      "expected_promql_name": "portfolio_notification_dlq_enqueued_total",
      "instrument": "Counter",
      "unit": "{notification}",
      "description": "New notifications sent to a dead-letter queue.",
      "allowed_attributes": [
        "reason_class"
      ],
      "attribute_value_limits": {
        "reason_class": 20
      },
      "expected_max_active_series": 20,
      "consumers": [
        "dlq-dashboard",
        "dlq-ingress-alert"
      ],
      "autoscaling": {
        "allowed": false,
        "reason": "DLQ ingress requires incident handling rather than automatic scale-out."
      }
    },
    {
      "otel_name": "portfolio.notification.dlq.depth",
      "expected_promql_name": "portfolio_notification_dlq_depth",
      "instrument": "ObservableGauge",
      "unit": "{message}",
      "description": "Current unprocessed message count in a dead-letter queue.",
      "allowed_attributes": [
        "queue"
      ],
      "attribute_value_limits": {
        "queue": 20
      },
      "expected_max_active_series": 20,
      "consumers": [
        "dlq-dashboard",
        "dlq-depth-alert"
      ],
      "autoscaling": {
        "allowed": false,
        "reason": "DLQ processing uses a separately approved recovery workflow."
      }
    },
    {
      "otel_name": "portfolio.notification.queue.depth",
      "expected_promql_name": "portfolio_notification_queue_depth",
      "instrument": "ObservableGauge",
      "unit": "{message}",
      "description": "Observed main queue depth for dashboards and alert correlation.",
      "allowed_attributes": [
        "queue"
      ],
      "attribute_value_limits": {
        "queue": 20
      },
      "expected_max_active_series": 20,
      "consumers": [
        "queue-dashboard",
        "backlog-alert"
      ],
      "autoscaling": {
        "allowed": true,
        "provider": "keda-source-native",
        "metric_source": "queue-provider-api",
        "note": "KEDA does not query this exported observation metric when a native scaler exists."
      }
    },
    {
      "otel_name": "portfolio.notification.queue.oldest_age",
      "expected_promql_name": "portfolio_notification_queue_oldest_age_seconds",
      "instrument": "ObservableGauge",
      "unit": "s",
      "description": "Age of the oldest message waiting in the main queue.",
      "allowed_attributes": [
        "queue"
      ],
      "attribute_value_limits": {
        "queue": 20
      },
      "expected_max_active_series": 20,
      "consumers": [
        "queue-dashboard",
        "delivery-slo-alert"
      ],
      "autoscaling": {
        "allowed": false,
        "reason": "Use source-native backlog per replica; oldest age remains an SLO risk signal."
      }
    },
    {
      "otel_name": "portfolio.notification.provider.request.duration",
      "expected_promql_name": "portfolio_notification_provider_request_duration_seconds",
      "instrument": "Histogram",
      "unit": "s",
      "description": "External provider request duration.",
      "allowed_attributes": [
        "provider",
        "result"
      ],
      "attribute_value_limits": {
        "provider": 10,
        "result": 10
      },
      "expected_max_active_series": 1000,
      "consumers": [
        "provider-dashboard",
        "provider-latency-alert"
      ],
      "autoscaling": {
        "allowed": false,
        "reason": "Scaling workers cannot repair an external provider latency incident."
      }
    },
    {
      "otel_name": "portfolio.notification.duplicate",
      "expected_promql_name": "portfolio_notification_duplicate_total",
      "instrument": "Counter",
      "unit": "{notification}",
      "description": "Duplicate notifications detected by the idempotency control.",
      "allowed_attributes": [
        "channel",
        "reason_class"
      ],
      "attribute_value_limits": {
        "channel": 10,
        "reason_class": 20
      },
      "expected_max_active_series": 200,
      "consumers": [
        "business-integrity-dashboard",
        "duplicate-alert"
      ],
      "autoscaling": {
        "allowed": false,
        "reason": "Duplicate detection is a business-integrity signal."
      }
    }
  ]
}
