{
  "schema_version": "1.0",
  "policy_version": "monitoring-alert-baseline-2026-08-08",
  "implementation_status": "documented_target",
  "description": "Monitoring Agent와 알람 구현이 공유하는 초기 임계값 예제입니다. 실제 production 적용 전 서비스 SLO와 2~4주 baseline으로 조정해야 합니다.",
  "defaults": {
    "evaluation_period": "1m",
    "missing_data": "missing",
    "warning_routes": ["slack", "email"],
    "critical_routes": ["pagerduty", "slack", "email"],
    "recovery_for": "15m"
  },
  "rules": [
    {
      "rule_id": "host_cpu_utilization_high",
      "query_id": "host_cpu_utilization_percent",
      "source": "prometheus",
      "status": "query_catalog_ready",
      "scope": "linux-node",
      "unit": "percent",
      "query": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
      "warning": {"comparison": "gte", "threshold": 80, "for": "10m", "datapoints_to_alarm": 8, "evaluation_periods": 10},
      "critical": {"comparison": "gte", "threshold": 90, "for": "5m", "datapoints_to_alarm": 5, "evaluation_periods": 5},
      "recovery": {"comparison": "lt", "threshold": 70, "for": "15m"},
      "missing_data": "missing",
      "page_condition": "production critical 서비스는 latency, error, queue 또는 ready capacity 이상과 결합해 paging하고 CPU 단독 상승은 원인 후보로 취급합니다.",
      "runbook": "CPU별 사용률, load average, throttling, run queue, 상위 process와 최근 배포를 확인합니다."
    },
    {
      "rule_id": "host_memory_utilization_high",
      "query_id": "host_memory_utilization_percent",
      "source": "prometheus",
      "status": "query_catalog_ready",
      "scope": "linux-node",
      "unit": "percent",
      "query": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
      "warning": {"comparison": "gte", "threshold": 80, "for": "10m", "datapoints_to_alarm": 8, "evaluation_periods": 10},
      "critical": {"comparison": "gte", "threshold": 90, "for": "5m", "datapoints_to_alarm": 5, "evaluation_periods": 5},
      "recovery": {"comparison": "lt", "threshold": 75, "for": "15m"},
      "missing_data": "missing",
      "page_condition": "OOM, swap thrashing, memory pressure 또는 serving capacity 감소가 함께 확인되면 즉시 paging합니다.",
      "runbook": "MemAvailable, swap in/out, major fault, OOM log, cgroup working set과 상위 process를 확인합니다."
    },
    {
      "rule_id": "host_filesystem_utilization_high",
      "query_id": "host_filesystem_utilization_percent",
      "source": "prometheus",
      "status": "query_catalog_ready",
      "scope": "linux-node-filesystem",
      "unit": "percent",
      "query": "100 * (1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"}))",
      "warning": {"comparison": "gte", "threshold": 80, "for": "15m", "datapoints_to_alarm": 12, "evaluation_periods": 15},
      "critical": {"comparison": "gte", "threshold": 90, "for": "10m", "datapoints_to_alarm": 8, "evaluation_periods": 10},
      "recovery": {"comparison": "lt", "threshold": 75, "for": "15m"},
      "missing_data": "missing",
      "page_condition": "95% 이상, read-only filesystem 또는 24시간 내 full 예측은 지속 시간과 무관하게 긴급 escalation 후보입니다.",
      "runbook": "mountpoint, 증가율, inode, deleted-open file, log rotation, container image와 임시 파일을 확인합니다."
    },
    {
      "rule_id": "host_inode_utilization_high",
      "query_id": "host_inode_utilization_percent",
      "source": "prometheus",
      "status": "query_catalog_ready",
      "scope": "linux-node-filesystem",
      "unit": "percent",
      "query": "100 * (1 - (node_filesystem_files_free{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_files{fstype!~\"tmpfs|overlay|squashfs\"}))",
      "warning": {"comparison": "gte", "threshold": 80, "for": "15m", "datapoints_to_alarm": 12, "evaluation_periods": 15},
      "critical": {"comparison": "gte", "threshold": 90, "for": "10m", "datapoints_to_alarm": 8, "evaluation_periods": 10},
      "recovery": {"comparison": "lt", "threshold": 75, "for": "15m"},
      "missing_data": "missing",
      "page_condition": "파일 생성 실패나 node DiskPressure가 동반되면 critical로 escalation합니다.",
      "runbook": "작은 파일 급증 경로, log spool, container layer와 임시 디렉터리를 확인합니다."
    },
    {
      "rule_id": "workload_cpu_request_utilization_high",
      "query_id": "workload_cpu_request_utilization_percent",
      "source": "prometheus",
      "status": "query_catalog_ready",
      "scope": "kubernetes-pod",
      "unit": "percent-of-request",
      "query": "100 * sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{namespace=\"{namespace}\",container!=\"\",image!=\"\"}[5m])) / clamp_min(sum by (namespace, pod) (kube_pod_container_resource_requests{namespace=\"{namespace}\",resource=\"cpu\",unit=\"core\"}), 0.001)",
      "warning": {"comparison": "gte", "threshold": 80, "for": "10m", "datapoints_to_alarm": 8, "evaluation_periods": 10},
      "critical": {"comparison": "gte", "threshold": 95, "for": "5m", "datapoints_to_alarm": 5, "evaluation_periods": 5},
      "recovery": {"comparison": "lt", "threshold": 70, "for": "15m"},
      "missing_data": "missing",
      "page_condition": "CPU request 초과 자체는 장애가 아니므로 throttling, HPA maxed, latency 또는 error와 결합합니다.",
      "runbook": "request 정확성, limit, throttling, HPA current/max replica, Pending Pod와 node capacity를 확인합니다."
    },
    {
      "rule_id": "workload_memory_limit_utilization_high",
      "query_id": "workload_memory_limit_utilization_percent",
      "source": "prometheus",
      "status": "query_catalog_ready",
      "scope": "kubernetes-container",
      "unit": "percent-of-limit",
      "query": "100 * container_memory_working_set_bytes{namespace=\"{namespace}\",container!=\"\",image!=\"\"} / clamp_min(kube_pod_container_resource_limits{namespace=\"{namespace}\",resource=\"memory\",unit=\"byte\"}, 1)",
      "warning": {"comparison": "gte", "threshold": 80, "for": "10m", "datapoints_to_alarm": 8, "evaluation_periods": 10},
      "critical": {"comparison": "gte", "threshold": 90, "for": "5m", "datapoints_to_alarm": 5, "evaluation_periods": 5},
      "recovery": {"comparison": "lt", "threshold": 75, "for": "15m"},
      "missing_data": "missing",
      "page_condition": "OOMKilled 또는 memory pressure가 발생하면 지속 시간과 무관하게 critical incident 후보입니다.",
      "runbook": "working set 추세, limit/request, OOM termination, heap와 cache, sidecar 포함 전체 container를 확인합니다."
    },
    {
      "rule_id": "workload_cpu_throttling_high",
      "query_id": "workload_cpu_throttling_percent",
      "source": "prometheus",
      "status": "query_catalog_ready",
      "scope": "kubernetes-container",
      "unit": "percent",
      "query": "100 * sum by (namespace, pod, container) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"{namespace}\"}[5m])) / clamp_min(sum by (namespace, pod, container) (rate(container_cpu_cfs_periods_total{namespace=\"{namespace}\"}[5m])), 0.001)",
      "warning": {"comparison": "gte", "threshold": 20, "for": "10m", "datapoints_to_alarm": 8, "evaluation_periods": 10},
      "critical": {"comparison": "gte", "threshold": 40, "for": "5m", "datapoints_to_alarm": 5, "evaluation_periods": 5},
      "recovery": {"comparison": "lt", "threshold": 10, "for": "15m"},
      "missing_data": "missing",
      "page_condition": "latency SLO 위반이나 ready capacity 감소와 결합될 때 paging합니다.",
      "runbook": "container limit, request, throttled period, HPA와 latency 상관관계를 확인합니다."
    },
    {
      "rule_id": "alb_target_5xx_ratio_high",
      "query_id": "alb_target_5xx_ratio_percent",
      "source": "cloudwatch-metric-math",
      "status": "documented_target",
      "scope": "aws-application-load-balancer",
      "unit": "percent",
      "query": "IF(RequestCount>0,100*HTTPCode_Target_5XX_Count/RequestCount,0)",
      "warning": {"comparison": "gte", "threshold": 2, "for": "5m", "datapoints_to_alarm": 3, "evaluation_periods": 5},
      "critical": {"comparison": "gte", "threshold": 5, "for": "5m", "datapoints_to_alarm": 5, "evaluation_periods": 5},
      "recovery": {"comparison": "lt", "threshold": 1, "for": "10m"},
      "minimum_traffic": "RequestCount >= 100 over 5m",
      "missing_data": "missing",
      "page_condition": "synthetic failure, healthy target 감소 또는 latency SLO 위반과 결합하면 customer-impact critical로 paging합니다.",
      "runbook": "target별 5xx, healthy host, target response time, deployment marker와 application error aggregate를 확인합니다."
    },
    {
      "rule_id": "service_latency_high",
      "query_id": "service_request_latency_p95_seconds",
      "source": "prometheus-or-cloudwatch",
      "status": "query_catalog_ready",
      "scope": "service",
      "unit": "seconds",
      "query": "histogram_quantile(0.95, sum by (le, service) (rate(http_server_request_duration_seconds_bucket{service=\"{service}\"}[5m])))",
      "warning": {"comparison": "gte", "threshold": 1, "for": "10m", "datapoints_to_alarm": 8, "evaluation_periods": 10},
      "critical": {"comparison": "gte", "threshold": 2, "for": "5m", "datapoints_to_alarm": 5, "evaluation_periods": 5},
      "recovery": {"comparison": "lt", "threshold": 0.8, "for": "15m"},
      "minimum_traffic": "request_count >= 100 over 5m",
      "missing_data": "missing",
      "page_condition": "1초와 2초는 예제값이며 production에서는 route별 latency SLO와 timeout budget으로 반드시 대체합니다.",
      "runbook": "route, dependency, upstream, queue와 trace별 latency를 분리하고 error와 saturation을 함께 확인합니다."
    },
    {
      "rule_id": "kubernetes_node_not_ready",
      "query_id": "k8s_node_not_ready_count",
      "source": "prometheus",
      "status": "query_catalog_ready",
      "scope": "kubernetes-node",
      "unit": "count",
      "query": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"} == 0)",
      "warning": {"comparison": "gte", "threshold": 1, "for": "2m", "datapoints_to_alarm": 2, "evaluation_periods": 2},
      "critical": {"comparison": "gte", "threshold": 1, "for": "5m", "datapoints_to_alarm": 5, "evaluation_periods": 5},
      "recovery": {"comparison": "lt", "threshold": 1, "for": "10m"},
      "missing_data": "breaching",
      "page_condition": "critical workload의 ready replica 감소, AZ capacity 손실 또는 연속 node 장애가 동반되면 즉시 paging합니다.",
      "runbook": "node condition, EC2 status, kubelet, CNI, disk pressure, Pod placement와 PDB를 확인합니다."
    },
    {
      "rule_id": "monitoring_target_missing",
      "query_id": "monitoring_target_up",
      "source": "prometheus",
      "status": "query_catalog_ready",
      "scope": "telemetry-pipeline",
      "unit": "boolean",
      "query": "max by (job, instance) (up)",
      "warning": {"comparison": "lte", "threshold": 0, "for": "5m", "datapoints_to_alarm": 5, "evaluation_periods": 5},
      "critical": {"comparison": "lte", "threshold": 0, "for": "15m", "datapoints_to_alarm": 15, "evaluation_periods": 15},
      "recovery": {"comparison": "gte", "threshold": 1, "for": "10m"},
      "missing_data": "breaching",
      "page_condition": "관측 공백은 정상 상태로 해석하지 않으며 production critical target 전체가 사라지면 monitoring incident로 paging합니다.",
      "runbook": "Prometheus target, service discovery, exporter, network policy, remote-write와 collector queue/drop을 확인합니다."
    }
  ]
}
